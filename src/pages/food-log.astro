---
import { SITE } from "../config";
import foodLogData from "../data/food-log.json";

const entries = foodLogData.entries;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

function formatDate(dateStr: string) {
  const date = new Date(dateStr + "T12:00:00");
  return date.toLocaleDateString("sv-SE", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

function formatMonth(dateStr: string) {
  const date = new Date(dateStr + "T12:00:00");
  return date.toLocaleDateString("sv-SE", { year: "numeric", month: "long" });
}

const oldest = entries[entries.length - 1].date;
const newest = entries[0].date;
const subtitle = formatMonth(oldest) + " – " + formatMonth(newest);
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <title>Food Log - {SITE.title}</title>
    <meta name="title" content="Food Log" />
    <meta name="description" content="En logg över mat som lagats och ätits." />
    <meta name="author" content={SITE.author} />
  </head>
  <body>
    <main class="log-container">
      <header class="log-header">
        <h1 class="log-title">Food Log</h1>
        <p class="log-subtitle">{subtitle}</p>
      </header>

      <section class="log-grid">
        {
          entries.map(entry => (
            <article class="log-card">
              <div class="log-card-image">
                {entry.image ? (
                  <button
                    class="log-card-zoom"
                    aria-label={`Visa ${entry.dish} i helskärm`}
                  >
                    <img src={entry.image} alt={entry.dish} loading="lazy" />
                  </button>
                ) : (
                  <div class="log-card-placeholder">
                    <span class="log-card-placeholder-icon">🍽</span>
                  </div>
                )}
              </div>
              <div class="log-card-body">
                <time class="log-card-date" datetime={entry.date}>
                  {formatDate(entry.date)}
                </time>
                <h2 class="log-card-dish">{entry.dish}</h2>
                {entry.notes && <p class="log-card-notes">{entry.notes}</p>}
              </div>
            </article>
          ))
        }
      </section>
    </main>

    <dialog class="lightbox" aria-label="Bildvisare">
      <img class="lightbox-img" alt="" />
      <button class="lightbox-close" aria-label="Stäng">&#10005;</button>
    </dialog>

    <script>
      const lightbox = document.querySelector<HTMLDialogElement>(".lightbox");
      const lightboxImg = lightbox?.querySelector<HTMLImageElement>("img");
      const images = Array.from(
        document.querySelectorAll<HTMLImageElement>(".log-card-zoom img")
      );
      let shown = 0;

      function show(i: number) {
        if (!lightboxImg) return;
        shown = (i + images.length) % images.length;
        lightboxImg.src = images[shown].src;
        lightboxImg.alt = images[shown].alt;
      }

      document
        .querySelectorAll<HTMLButtonElement>(".log-card-zoom")
        .forEach((btn, i) =>
          btn.addEventListener("click", () => {
            show(i);
            lightbox?.showModal();
          })
        );

      // Any click closes, so tapping the photo or the dark area both exit.
      lightbox?.addEventListener("click", () => lightbox.close());
      lightbox?.addEventListener("keydown", e => {
        if (e.key === "ArrowRight") show(shown + 1);
        if (e.key === "ArrowLeft") show(shown - 1);
      });
    </script>
  </body>
</html>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: Garamond, Georgia, serif;
    background: #fafaf8;
    min-height: 100vh;
    padding: 60px 20px;
  }

  .log-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .log-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .log-title {
    font-size: 3em;
    font-weight: 400;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #1a1a1a;
  }

  .log-subtitle {
    margin-top: 12px;
    font-size: 1em;
    color: #999;
    font-style: italic;
    letter-spacing: 1px;
  }

  .log-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 30px;
  }

  .log-card {
    background: #fff;
    border: 1px solid #e8e8e6;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .log-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
  }

  .log-card-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .log-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .log-card-zoom {
    display: block;
    width: 100%;
    height: 100%;
    border: none;
    background: none;
    cursor: zoom-in;
  }

  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    border: none;
    background: rgba(0, 0, 0, 0.92);
    cursor: zoom-out;
  }

  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.92);
  }

  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .lightbox-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    color: white;
    font-size: 1.1rem;
    cursor: pointer;
  }

  .log-card-placeholder {
    width: 100%;
    height: 100%;
    background: #f0ede8;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .log-card-placeholder-icon {
    font-size: 2.5em;
    opacity: 0.4;
  }

  .log-card-body {
    padding: 20px 24px 24px;
  }

  .log-card-date {
    display: block;
    font-size: 0.8em;
    color: #aaa;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
    font-style: italic;
  }

  .log-card-dish {
    font-size: 1.1em;
    font-weight: 400;
    color: #1a1a1a;
    line-height: 1.4;
    letter-spacing: 0.3px;
  }

  .log-card-notes {
    margin-top: 10px;
    font-size: 0.85em;
    color: #888;
    font-style: italic;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    body {
      padding: 30px 15px;
    }

    .log-header {
      margin-bottom: 40px;
    }

    .log-title {
      font-size: 2em;
      letter-spacing: 2px;
    }

    .log-grid {
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 20px;
    }
  }

  @media (max-width: 480px) {
    .log-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
