---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Tag from "@components/Tag.astro";
import Datetime from "@components/Datetime";
import TOC from "@components/TOC.tsx";
import type { MarkdownInstance } from "astro";
import type { Frontmatter } from "src/types";

export interface Props {
  post: MarkdownInstance<Frontmatter>;
}

const { frontmatter, Content } = Astro.props.post;

const { title, author, description, ogImage, datetime, tags } = frontmatter;
const headings = Astro.props.post.getHeadings();
---

<Layout
  title={title}
  author={author}
  description={description}
  ogImage={ogImage}
>
  <Header />
  <main id="main-content" tabindex="-1" class="post-layout">
    <header class="post-header">
      <a class="back-link" href="/posts">← All posts</a>
      <h1 class="post-title">{title}</h1>
      <Datetime datetime={datetime} size="sm" className="post-date" />
      <ul class="tags-container" aria-label="Tags">
        {tags?.map(tag => <Tag name={tag} size="sm" />)}
      </ul>
    </header>
    {
      headings.length > 0 && (
        <details class="mobile-outline">
          <summary>On this page</summary>
          <TOC headings={headings} />
        </details>
      )
    }
    <article id="article" class="prose article-body">
      <Content />
    </article>
    {
      headings.length > 0 && (
        <aside class="desktop-outline" aria-label="Article outline">
          <div class="outline-sticky">
            <p class="outline-label">On this page</p>
            <TOC headings={headings} />
          </div>
        </aside>
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  .post-layout {
    width: 100%;
    max-width: 48rem;
    margin: 0 auto;
    padding: 2.5rem 1rem 5rem;
  }
  .post-header {
    margin-bottom: 2.5rem;
  }
  .back-link {
    font-size: 0.875rem;
    color: rgba(var(--color-text-base), 0.7);
  }
  .back-link:hover {
    color: rgb(var(--color-accent));
  }
  .post-title {
    margin: 1.25rem 0;
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin-top: 0.5rem;
  }
  .article-body {
    min-width: 0;
    max-width: none;
  }
  .desktop-outline {
    display: none;
  }
  .mobile-outline {
    margin-bottom: 2rem;
    padding: 1rem 0;
    border-block: 1px solid rgba(var(--color-text-base), 0.15);
  }
  .mobile-outline summary {
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .mobile-outline[open] summary {
    margin-bottom: 1rem;
  }
  @media (min-width: 1280px) {
    .post-layout {
      position: relative;
    }
    .desktop-outline {
      display: block;
      position: absolute;
      top: 2.5rem;
      bottom: 5rem;
      left: calc(100% + 1.5rem);
      width: min(13rem, calc((100vw - 48rem) / 2 - 3rem));
    }
    .outline-sticky {
      position: sticky;
      top: 2rem;
      max-height: calc(100vh - 4rem);
      overflow-y: auto;
    }
    .outline-label {
      font-size: 0.75rem;
      font-weight: 600;
      margin-bottom: 1rem;
    }
    .mobile-outline {
      display: none;
    }
  }
  @media (max-width: 639px) {
    .post-layout {
      padding-top: 1.75rem;
    }
    .post-header {
      margin-bottom: 1.75rem;
    }
  }
</style>
