---
import { SITE } from "src/config";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import ImageCarousel from "@components/ImageCarousel.astro";
import Layout from "./Layout.astro";

export interface Props {
  frontmatter: {
    title: string;
    navName?: "posts" | "tags" | "about" | "search" | "resume" | "lists";
    description?: string;
    images?: { src: string; alt?: string }[];
    source?: { label: string; url: string };
  };
}

const { frontmatter } = Astro.props;
const profilePage = ["about", "resume"].includes(frontmatter.navName ?? "");
const cookingMode = Astro.url.pathname.startsWith("/recipes/");
---

<Layout
  title={`${frontmatter.title} | ${SITE.title}`}
  description={frontmatter.description}
>
  <Header activeNav={frontmatter.navName} />
  <!--    <Breadcrumbs/>-->
  <main id="main-content">
    <section
      id="about"
      class:list={[
        "mt-12 mb-28 prose max-w-3xl prose-img:border-0",
        { "profile-page": profilePage },
      ]}
    >
      <h1 class="text-4xl sm:text-4xl tracking-wider text-center">
        {frontmatter.title}
      </h1>
      <hr class="w-48 mx-auto border-2 text-center rounded mt-2" />
      {
        cookingMode && (
          <div class="flex justify-end gap-2 -mt-2 mb-4">
            <label for="cooking-mode" class="text-xs text-stone-400">
              Cooking mode
            </label>
            <button
              id="cooking-mode"
              role="switch"
              aria-checked="false"
              class="cooking-toggle relative inline-flex h-4 w-7 items-center rounded-full bg-skin-card text-[0px] transition-colors"
            >
              <span class="cooking-dot inline-block h-3 w-3 rounded-full bg-skin-fill transition-transform translate-x-0.5" />
            </button>
          </div>
        )
      }
      <slot />
      {
        frontmatter.source && (
          <p>
            <em>
              {frontmatter.source.label} —{" "}
              <a href={frontmatter.source.url}>{frontmatter.source.url}</a>
            </em>
          </p>
        )
      }
      {
        frontmatter.images && frontmatter.images.length > 0 && (
          <ImageCarousel images={frontmatter.images} />
        )
      }
    </section>
  </main>
  <Footer />

  <style>
    .profile-page {
      font-size: 1.0625rem;
      line-height: 1.8;
      overflow-wrap: anywhere;
    }
    .profile-page > h1 {
      text-align: left;
      letter-spacing: -0.035em;
      font-size: clamp(2rem, 4vw, 2.75rem);
      margin-bottom: 2rem;
    }
    .profile-page > hr {
      display: none;
    }
    .profile-page :global(h2) {
      font-size: 1.5rem;
      letter-spacing: -0.02em;
      scroll-margin-top: 2rem;
    }
    @media (max-width: 639px) {
      .profile-page {
        margin-top: 2rem;
      }
    }

    .cooking-toggle[data-on="true"] {
      background-color: rgb(var(--color-accent));
    }
    .cooking-toggle[data-on="true"] .cooking-dot {
      transform: translateX(0.875rem);
    }
  </style>

  <script>
    const btn = document.getElementById("cooking-mode");
    if (btn) {
      const dot = btn.querySelector(".cooking-dot");
      let wakeLock = null;

      btn.addEventListener("click", async () => {
        if (wakeLock) {
          await wakeLock.release();
          return;
        }
        try {
          wakeLock = await navigator.wakeLock.request("screen");
          btn.dataset.on = "true";
          btn.setAttribute("aria-checked", "true");
          wakeLock.addEventListener("release", () => {
            wakeLock = null;
            delete btn.dataset.on;
            btn.setAttribute("aria-checked", "false");
          });
        } catch {
          btn.style.display = "none";
        }
      });
    }
  </script>
</Layout>
