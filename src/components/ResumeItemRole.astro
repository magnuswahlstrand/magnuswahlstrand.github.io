---
export interface Props {
  role: {
    location?: string;
    title: string;
    description: string;
    from: string;
    to: string;
    tags: string[];
  };
  isMultiRow: boolean;
  isFirst: boolean;
  isOngoing?: boolean;
}

const { isFirst, isMultiRow, isOngoing, role } = Astro.props;
const timespanText = `${role.from} - ${isOngoing && isFirst ? "Present" : role.to}`;
---

<div class:list={["resume-role", { "later-role": !isFirst }]}>
  <h4>{role.title}</h4>
  {isMultiRow && <div class="role-meta">{timespanText}</div>}
  {role.location && <div class="role-meta">{role.location}</div>}
  <div class="role-description">
    {role.description.split("\n").map(paragraph => <p>{paragraph}</p>)}
  </div>
  <ul class="role-skills" aria-label="Skills">
    {role.tags.map(tag => <li>{tag}</li>)}
  </ul>
</div>
<style>
  .resume-role {
    min-width: 0;
  }
  .later-role {
    margin-top: 1.75rem;
  }
  h4 {
    font-size: 1rem;
    line-height: 1.5;
    margin: 0;
  }
  .role-meta {
    font-size: 0.8125rem;
    color: rgba(var(--color-text-base), 0.7);
    margin-top: 0.25rem;
  }
  .role-description {
    font-size: 1rem;
    line-height: 1.75;
  }
  .role-description p {
    margin: 0.75rem 0;
  }
  .role-skills {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .role-skills li {
    margin: 0;
    padding: 0.125rem 0.5rem;
    border-radius: 0.25rem;
    background: rgba(var(--color-card), 0.5);
    color: rgba(var(--color-text-base), 0.8);
    font-size: 0.75rem;
    line-height: 1.6;
  }
</style>
