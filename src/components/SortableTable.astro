<div class="not-prose my-4 overflow-x-auto">
  <table class="sortable w-full text-sm">
    <slot />
  </table>
</div>

<style is:global>
  table.sortable {
    border-collapse: collapse;
  }
  table.sortable th,
  table.sortable td {
    @apply px-3 py-1.5 text-left text-skin-base;
  }
  table.sortable a {
    @apply text-skin-base hover:text-skin-accent;
  }
  table.sortable thead th {
    @apply cursor-pointer select-none border-b border-skin-line whitespace-nowrap;
  }
  table.sortable thead th:hover {
    @apply text-skin-accent;
  }
  table.sortable tbody tr {
    @apply border-b border-skin-line;
  }
  table.sortable tbody tr:last-child {
    @apply border-b-0;
  }
  table.sortable thead th[data-type="none"] {
    @apply cursor-default;
  }
  table.sortable thead th[data-type="none"]:hover {
    @apply text-skin-base;
  }
</style>

<script>
  document.querySelectorAll("table.sortable").forEach(table => {
    const tbody = table.querySelector("tbody");
    const headers = table.querySelectorAll("thead th");
    headers.forEach(header => {
      const type = header.dataset.type ?? "text";
      if (type === "none") return;
      header.addEventListener("click", () => {
        const index = Array.from(headers).indexOf(header);
        const rows = Array.from(tbody.querySelectorAll("tr"));
        const current = header.getAttribute("data-sort");
        const next = current === "asc" ? "desc" : "asc";
        rows.sort((a, b) => {
          const aCell = a.children[index] as HTMLElement;
          const bCell = b.children[index] as HTMLElement;
          const avText = aCell.dataset.sortValue ?? aCell.textContent.trim();
          const bvText = bCell.dataset.sortValue ?? bCell.textContent.trim();
          if (type === "number") {
            const isSet = (t: string) => t && t !== "–";
            const numeric = (t: string): number =>
              isSet(t) ? parseFloat(t) : Infinity;
            const aSet = isSet(avText);
            const bSet = isSet(bvText);
            let cmp: number;
            if (aSet !== bSet) {
              // unset values always go last in ascending order
              cmp = aSet ? -1 : 1;
            } else if (bSet) {
              // present values: newest/highest first in ascending order
              cmp = numeric(bvText) - numeric(avText);
              if (next === "desc") cmp = -cmp;
            } else {
              cmp = 0;
            }
            return next === "asc" ? cmp : -cmp;
          }
          const cmp =
            type === "date"
              ? new Date(avText).getTime() - new Date(bvText).getTime()
              : avText.localeCompare(bvText);
          return next === "asc" ? cmp : -cmp;
        });
        rows.forEach(row => tbody.appendChild(row));
        headers.forEach(h => h.removeAttribute("data-sort"));
        header.setAttribute("data-sort", next);
      });
    });
  });
</script>
