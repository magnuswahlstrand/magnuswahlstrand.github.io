---
export interface Props {
  company: {
    name: string;
    linkedin: string;
    location: string;
  };
  isOngoing?: boolean;
  type: "Freelance" | "Full-time";
  to: string;
  from: string;
  isMultiRow: boolean;
}

const { company, isOngoing, type, to, from, isMultiRow } = Astro.props;
const timespanText = `${from} - ${isOngoing ? "Present" : to}`;
---

<div class="company-heading">
  <h3><a href={company.linkedin}>{company.name}</a></h3>
  <div class="company-dates">{type} · {timespanText}</div>
</div>
<style>
  .company-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 1rem;
  }
  h3 {
    margin: 0;
    font-size: 1.25rem;
  }
  h3 a {
    text-decoration: none;
  }
  .company-dates {
    font-size: 0.8125rem;
    color: rgba(var(--color-text-base), 0.7);
  }
</style>
