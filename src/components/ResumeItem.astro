---
import ResumeItemRole from "./ResumeItemRole.astro";
import ResumeItemTitle from "./ResumeItemTitle.astro";
export interface Props {
  company: {
    name: string;
    linkedin: string;
  };
  isOngoing?: boolean;
  type: "Freelance" | "Full-time";
  roles: {
    location?: string;
    title: string;
    description: string;
    from: string;
    to: string;
    tags: string[];
  }[];
}

const item = Astro.props;

const isMultiRow = item.roles.length > 1;
const to = item.roles[0].to;
const from = item.roles[item.roles.length - 1].from;

const titleProps = { ...item, to, from, isMultiRow };
---

<div class="resume-company text-skin-base">
  <ResumeItemTitle {...titleProps} />
  {
    item.roles.map((role, index) => {
      return (
        <ResumeItemRole
          role={role}
          isFirst={index === 0}
          isMultiRow={isMultiRow}
          isOngoing={item.isOngoing}
        />
      );
    })
  }
</div>

<style>
  .resume-company {
    border-top: 1px solid rgba(var(--color-text-base), 0.2);
    padding-top: 1.25rem;
    min-width: 0;
  }
</style>
