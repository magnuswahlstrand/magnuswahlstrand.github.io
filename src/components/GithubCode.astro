---
import { Code } from "astro/components";
import { ClipboardCopy } from "@astro-github-elements/clipboard-copy";

export interface Props {
  repo: string;
  path: string;
}

const { repo, path } = Astro.props;
const rawUrl = `https://raw.githubusercontent.com/${repo}/main/${path}`;
const url = `https://github.com/${repo}/blob/main/${path}`;
const fileEnding = url.split(".").pop();

const response = await fetch(rawUrl);
const code = await response.text();
---

<div class="github-code">
  <div class="code-toolbar">
    <a href={url}>{path}</a>
    <ClipboardCopy value={code}>Copy</ClipboardCopy>
  </div>
  <Code code={code} lang={fileEnding} theme="github-dark" />
</div>

<style>
  .github-code {
    min-width: 0;
    margin: 2rem 0;
  }
  .code-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background: #24292e;
    color: #e1e4e8;
    border-bottom: 1px solid #444d56;
    border-radius: 0.5rem 0.5rem 0 0;
    font-size: 0.8125rem;
  }
  .code-toolbar a {
    min-width: 0;
    overflow-wrap: anywhere;
    color: #e1e4e8 !important;
  }
  .code-toolbar :global(clipboard-copy) {
    flex-shrink: 0;
    cursor: pointer;
    padding: 0.25rem;
  }
  .code-toolbar :global(clipboard-copy:focus-visible) {
    outline: 2px solid white;
    outline-offset: 2px;
  }
  .github-code :global(pre) {
    margin: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }
</style>
